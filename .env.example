# Embeddings (sempre OpenAI)
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small

# LLM de resposta: anthropic ou openai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-5-5
# Se usar openai: LLM_PROVIDER=openai e LLM_MODEL=gpt-4o-mini

# Reranking (FlashRank)
RERANK=true
RERANK_CANDIDATES=20

# Busca híbrida (lexical + vetorial)
HYBRID=true
FTS_CONFIG=portuguese
RRF_K=60
